<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cue.Domain\Cue.Domain.csproj" />
    <ProjectReference Include="..\Cue.Storage\Cue.Storage.csproj" />
    <ProjectReference Include="..\Cue.Parsing\Cue.Parsing.csproj" />
    <ProjectReference Include="..\ViewModels\Cue.ViewModels.csproj" />
  </ItemGroup>

  <!-- Notification scheduling is App-layer policy but has no WinUI dependency. Compile the same source
       into this cross-platform test assembly so its expected-set/diff core can use fakes without making
       the entire test project reference the Windows executable. -->
  <ItemGroup>
    <Compile Include="..\Services\INotificationPreferences.cs" Link="AppServices\INotificationPreferences.cs" />
    <Compile Include="..\Services\JsonSettingsFile.cs" Link="AppServices\JsonSettingsFile.cs" />
    <Compile Include="..\Services\IToastPresenter.cs" Link="AppServices\IToastPresenter.cs" />
    <Compile Include="..\Services\NotificationScheduler.cs" Link="AppServices\NotificationScheduler.cs" />
    <Compile Include="..\Services\ToastActivationPayload.cs" Link="AppServices\ToastActivationPayload.cs" />
    <Compile Include="..\Services\RecurringNotificationSource.cs" Link="AppServices\RecurringNotificationSource.cs" />
    <Compile Include="..\Services\ToastCompletionService.cs" Link="AppServices\ToastCompletionService.cs" />
    <Compile Include="..\Services\TaskOpenRouteResolver.cs" Link="AppServices\TaskOpenRouteResolver.cs" />
    <!-- Same idea for the updater: its release-response parsing is pure text→result logic with no WinUI
         dependency, and it is what decides whether a malformed body reaches the settings page's
         async void handler as an unhandled exception. -->
    <Compile Include="..\Services\UpdateService.cs" Link="AppServices\UpdateService.cs" />
  </ItemGroup>

</Project>
