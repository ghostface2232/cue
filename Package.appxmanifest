<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap rescap com desktop">

  <!-- Identity — Cue's product identity from Partner Center (Product management → Product identity).
       • Name / Publisher: the reserved "Package/Identity/Name" and "Package/Identity/Publisher".
         Local packaged runs deploy under a test certificate the WinUI MSIX tooling generates to match
         this Publisher; the Store re-signs the submitted package.
       • Version: MUST be Cue.csproj <Version> with ".0" appended (three parts → four). csproj is the
         single source of truth; the release script fails the build if these drift (mirroring the
         existing tag↔<Version> check). Bump <Version> in the csproj, then update this to match. -->
  <Identity
    Name="MingwanBae.Cue-"
    Publisher="CN=8C394440-DD7A-4859-B750-5AAA14564DCB"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Cue - 할 일 정리</DisplayName>
    <!-- PublisherDisplayName: the registered publisher display name from Partner Center. -->
    <PublisherDisplayName>Mingwan Bae</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <!-- The Store installs this framework dependency alongside Cue. The unpackaged installer must
         carry the VC++ runtime app-local because it has no package graph; the MSIX channel should
         use the standard VCLibs framework package instead of duplicating those DLLs in the app. -->
    <PackageDependency
      Name="Microsoft.VCLibs.140.00.UWPDesktop"
      MinVersion="14.0.27323.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <!-- Korean-first app: Korean parsing is the core feature, so the package ships ko-KR only for now. -->
  <Resources>
    <Resource Language="ko-KR" />
  </Resources>

  <Applications>
    <!-- Executable is the literal produced app host (AssemblyName "Cue" → Cue.exe). It must stay in
         lockstep with the com:ExeServer Executable below: WCT compat's packaged path (ManifestHelper)
         rejects the manifest unless the COM server's Executable resolves to the actually-running exe. -->
    <Application Id="App"
      Executable="Cue.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Cue - 할 일 정리"
        Description="자연스러운 한국어 한 줄로 할 일을 적으면 날짜·시간·우선순위를 알아서 정리해 주는 To-Do 앱이에요."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Toast activation for the packaged (Store) channel. WCT compat 7.1.3 reads the activator
             identity straight from this manifest (ManifestHelper.GetClsidFromPackageManifest), so it
             enforces exactly: the ToastActivatorCLSID GUID equals the com:Class Id; the com:ExeServer
             Executable equals the running exe (Cue.exe); and Arguments is exactly "-ToastActivated"
             (the WCT compat contract; the Windows App SDK's AppNotificationManager uses a different
             argument value that does not apply here). The CLSID is chosen once here and never generated
             at runtime. See ToolkitToastPresenter.TryRegisterPackaged. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="01C837CF-C37F-473B-BD77-A557AD27FC68" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Cue.exe" Arguments="-ToastActivated" DisplayName="Cue Toast Activator">
              <com:Class Id="01C837CF-C37F-473B-BD77-A557AD27FC68" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <!-- Desktop full-trust app: it needs runFullTrust and nothing else. Do not add capabilities the app
       does not exercise — each one widens the Store review surface and the consent prompt. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
